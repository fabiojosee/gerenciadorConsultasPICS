@model gerenciadorConsultasPICS.Areas.Usuario.ViewModels.Agendamento.Etapa3ViewModel
@{
    ViewData["Title"] = "Novo Agendamento - Etapa 3";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
}

<div class="form-container container-centralizado animate-fade-in">
    <!-- Indicador de Progresso -->
    <nav class="stepper" aria-label="Progresso do agendamento">
        <div class="stepper__step stepper__step--completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Etapa 1: Localização - concluída</span>
        </div>
        <div class="stepper__line stepper__line--active" aria-hidden="true"></div>
        <div class="stepper__step stepper__step--completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Etapa 2: Instituição - concluída</span>
        </div>
        <div class="stepper__line stepper__line--active" aria-hidden="true"></div>
        <div class="stepper__step stepper__step--active" aria-current="step">
            <span aria-hidden="true">3</span>
            <span class="sr-only">Etapa 3: Data - atual</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">4</span>
            <span class="sr-only">Etapa 4: Confirmação</span>
        </div>
    </nav>

    <h1>Selecione a data para iniciar os atendimentos</h1>
    <p class="text-muted mb-4">Escolha quando deseja começar seus atendimentos</p>

    <form id="formEtapa3" class="w-100" style="max-width: 500px;">
        <div class="form-group">
            <label for="dataInicio" class="form-label">
                Data início
                <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input id="dataInicio" name="dataInicio" type="text" value="@Model.dataInicio?.ToString("dd/MM/yyyy")"
                   required class="form-control" placeholder="__/__/____" readonly="readonly"
                   aria-required="true" aria-describedby="dataHelp" />
            <small id="dataHelp" class="text-muted">Clique para selecionar a data</small>
        </div>

        <div class="btn-group mt-4">
            <button type="submit" class="btn btn--lg">
                Continuar
                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>
    </form>
</div>


@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.10/jquery.mask.js"></script>
    <script type="text/javascript">

        function restringirDiaDaSemana(date) {
            const day = date.getDay();
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (day === parseInt('@ViewBag.DiaPermitidoParaAgendamento') && date >= today) {
                return [true];
            } else {
                return [false];
            }
        }

        $(document).ready(function () {

            $("#dataInicio").datepicker({
                showAnim: "slideDown",
                changeMonth: true,
                changeYear: true,
                beforeShowDay: restringirDiaDaSemana,
                minDate: 0,
                dateFormat: 'dd/mm/yy',
                dayNames: ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'],
                dayNamesMin: ['D', 'S', 'T', 'Q', 'Q', 'S', 'S', 'D'],
                dayNamesShort: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                monthNames: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'],
                monthNamesShort: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez']
            }).mask("99/99/9999");

            $('#formEtapa3').submit(function (e) {
                e.preventDefault();

                var formData = $(this).serialize();

                $.ajax({
                    url: '@Url.Action("NovoAgendamentoEtapa3", "Agendamento")',
                    type: 'POST',
                    data: formData,
                    success: function (resposta) {
                        if (resposta.sucesso) {
                            window.location.href = '@Url.Action("NovoAgendamentoEtapa4", "Agendamento")';
                        } else {
                            exibirAlerta(resposta.mensagem);
                        }
                    },
                    error: function (xhr, status, error) {
                        exibirAlerta('Erro ao finalizar etapa.');
                    }
                });
            });
        });
    </script>
}