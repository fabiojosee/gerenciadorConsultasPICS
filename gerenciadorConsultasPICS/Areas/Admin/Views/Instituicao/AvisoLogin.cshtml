@{
    ViewData["Title"] = "Aviso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="success-page" role="status" aria-live="polite">
    <div class="success-page__card">
        <div class="success-page__icon-wrapper">
            <svg class="success-page__icon" aria-hidden="true" focusable="false">
                <use xlink:href="/images/sprite.svg?v=1.0#success-icon"></use>
            </svg>
        </div>
        <h2 class="success-page__title">Cadastro realizado!</h2>
        <p class="success-page__description">
            Para acessar a área administrativa utilize o CNPJ como login e senha no primeiro acesso.
        </p>
        <p class="success-page__description">
            A senha deve ser alterada no primeiro acesso para uma senha segura.
        </p>
        <div class="success-page__action">
            <a href="/Admin/Instituicao/MinhasInstituicoes" class="btn">OK</a>
        </div>
    </div>
</div>
