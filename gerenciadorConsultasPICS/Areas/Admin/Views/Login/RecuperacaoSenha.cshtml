@{
    ViewData["Title"] = "Recuperação de senha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="list-container animate-fade-in">
    <h1>Recuperação de senha</h1>
    <p class="text-muted mb-4">Informe seu e-mail para receber o código de recuperação</p>

    <form id="formRecuperacaoSenha" class="w-100" style="max-width: 400px;">
        <div class="form-group">
            <label for="email" class="form-label">E-mail</label>
            <input type="email" id="email" name="email" class="form-control" required
                   placeholder="seu@email.com" />
        </div>

        <p class="text-muted mb-4">Um código será enviado para o e-mail cadastrado e deve ser informado na próxima etapa.</p>

        <button type="submit" class="btn btn--lg w-100">Continuar</button>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {

            $('#formRecuperacaoSenha').submit(function (e) {
                e.preventDefault();

                $.ajax({
                    url: '@Url.Action("EnviarCodigoRecuperacaoSenha", "Login")',
                    type: 'POST',
                    data: { email: $('#email').val() },
                    success: function (resposta) {
                        if (resposta.sucesso) {
                            window.location.href = '@Url.Action("RecuperacaoSenhaCodigo", "Login")';
                        } else {
                            exibirAlerta(resposta.mensagem);
                        }
                    },
                    error: function (xhr, status, error) {
                        exibirAlerta('Erro ao enviar código de recuperação de senha.');
                    }
                });
            });
        });
    </script>
}
