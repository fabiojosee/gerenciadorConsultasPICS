@model AgendaPics.Web.Areas.Usuario.ViewModels.Agendamento.Etapa2ViewModel
@{
    ViewData["Title"] = "Novo Agendamento - Etapa 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-container container-centralizado animate-fade-in">
    <!-- Indicador de Progresso -->
    <nav class="stepper" aria-label="Progresso do agendamento">
        <div class="stepper__step stepper__step--completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Etapa 1: Localização - concluída</span>
        </div>
        <div class="stepper__line stepper__line--active" aria-hidden="true"></div>
        <div class="stepper__step stepper__step--active" aria-current="step">
            <span aria-hidden="true">2</span>
            <span class="sr-only">Etapa 2: Instituição - atual</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">3</span>
            <span class="sr-only">Etapa 3: Data</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">4</span>
            <span class="sr-only">Etapa 4: Confirmação</span>
        </div>
    </nav>

    <h1>Escolha a instituição e prática</h1>
    <p class="text-muted mb-4">Selecione onde e qual prática deseja realizar</p>

    <form id="formEtapa2" class="w-100" style="max-width: 500px;">
        <div class="form-group">
            <label for="idInstituicao" class="form-label">
                Instituição
                <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="idInstituicao"
                    name="idInstituicao"
                    required
                    class="form-select"
                    aria-required="true"
                    aria-describedby="instituicaoHelp">
                <option value="">Selecione uma instituição</option>
                @foreach (var instituicao in ViewBag.Instituicoes)
                {
                    if (@instituicao.IdInstituicao == Model.idInstituicao)
                    {
                        <option value="@instituicao.IdInstituicao" selected>@instituicao.Nome</option>
                    }
                    else
                    {
                        <option value="@instituicao.IdInstituicao">@instituicao.Nome</option>
                    }
                }
            </select>
            <small id="instituicaoHelp" class="text-muted">Instituições disponíveis na sua região</small>
        </div>

        <div class="form-group">
            <label for="idPratica" class="form-label">
                Prática
                <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="idPratica"
                    name="idPratica"
                    required
                    class="form-select"
                    aria-required="true"
                    aria-describedby="praticaHelp">
                <option value="">Selecione uma prática</option>
            </select>
            <small id="praticaHelp" class="text-muted">Práticas oferecidas pela instituição</small>
        </div>

        <div class="btn-group mt-4">
            <button type="submit" id="btnContinuar" class="btn btn--lg">
                Continuar
                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
        function obterPraticas(idInstituicao) {
            var $selectPratica = $('#idPratica');
            $selectPratica.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ObterPraticasPorInstituicao", "Pratica", new { area = "Admin" })',
                type: 'GET',
                data: { idInstituicao: idInstituicao },
                success: function (resposta) {
                    $selectPratica.empty();
                    $selectPratica.append('<option value="">Selecione uma prática</option>');

                    if (resposta.sucesso) {
                        $.each(resposta.listaPraticas, function (index, pratica) {
                            var selected = '@Model.idPratica' == pratica.idPratica ? ' selected' : '';
                            $selectPratica.append('<option value="' + pratica.idPratica + '"' + selected + '>' + pratica.nome + '</option>');
                        });
                    } else {
                        exibirAlerta(resposta.mensagem);
                    }

                    $selectPratica.prop('disabled', false);
                },
                error: function () {
                    exibirAlerta('Erro ao carregar as práticas.');
                    $selectPratica.prop('disabled', false);
                }
            });
        }

        $(document).ready(function () {
            // Carrega práticas se já tiver instituição selecionada
            var instituicaoInicial = '@Model.idInstituicao';
            if (instituicaoInicial) {
                $('#idInstituicao').val(instituicaoInicial);
                obterPraticas(instituicaoInicial);
            }

            // Evento de mudança da instituição
            $('#idInstituicao').change(function () {
                var idInstituicao = $(this).val();

                if (idInstituicao) {
                    obterPraticas(idInstituicao);
                } else {
                    $('#idPratica').empty();
                    $('#idPratica').append('<option value="">Selecione uma prática</option>');
                }
            });

            // Submissão do formulário
            $('#formEtapa2').submit(function (e) {
                e.preventDefault();

                var formData = $(this).serialize();
                var $btn = $('#btnContinuar');
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("NovoAgendamentoEtapa2", "Agendamento")',
                    type: 'POST',
                    data: formData,
                    success: function (resposta) {
                        if (resposta.sucesso) {
                            window.location.href = '@Url.Action("NovoAgendamentoEtapa3", "Agendamento")';
                        } else {
                            exibirAlerta(resposta.mensagem);
                            $btn.prop('disabled', false);
                        }
                    },
                    error: function (xhr, status, error) {
                        exibirAlerta('Erro ao finalizar etapa. Tente novamente.');
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
