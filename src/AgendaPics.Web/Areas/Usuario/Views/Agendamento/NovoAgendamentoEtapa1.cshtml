@model AgendaPics.Web.Areas.Usuario.ViewModels.Agendamento.Etapa1ViewModel
@{
    ViewData["Title"] = "Novo Agendamento - Etapa 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-container container-centralizado animate-fade-in">
    <!-- Indicador de Progresso -->
    <nav class="stepper" aria-label="Progresso do agendamento">
        <div class="stepper__step stepper__step--active" aria-current="step">
            <span aria-hidden="true">1</span>
            <span class="sr-only">Etapa 1: Localização - atual</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">2</span>
            <span class="sr-only">Etapa 2: Instituição</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">3</span>
            <span class="sr-only">Etapa 3: Data</span>
        </div>
        <div class="stepper__line" aria-hidden="true"></div>
        <div class="stepper__step">
            <span aria-hidden="true">4</span>
            <span class="sr-only">Etapa 4: Confirmação</span>
        </div>
    </nav>

    <h1>Onde você mora?</h1>
    <p class="text-muted mb-4">Selecione o estado e a cidade para encontrar instituições próximas</p>

    <form id="formEtapa1" class="w-100" style="max-width: 500px;">
        <div class="form-group">
            <label for="idEstadoPaciente" class="form-label">
                Estado
                <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="idEstadoPaciente"
                    name="idEstadoPaciente"
                    required
                    class="form-select"
                    aria-required="true"
                    aria-describedby="estadoHelp">
                <option value="">Selecione um estado</option>
                @foreach (var estado in ViewBag.Estados)
                {
                    if (estado.IdEstado == Model.idEstadoPaciente)
                    {
                        <option value="@estado.IdEstado" selected>@estado.Nome (@estado.Sigla)</option>
                    }
                    else
                    {
                        <option value="@estado.IdEstado">@estado.Nome (@estado.Sigla)</option>
                    }
                }
            </select>
            <small id="estadoHelp" class="text-muted">Escolha o estado onde você reside</small>
        </div>

        <div class="form-group">
            <label for="idCidadePaciente" class="form-label">
                Cidade
                <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="idCidadePaciente"
                    name="idCidadePaciente"
                    required
                    class="form-select"
                    aria-required="true"
                    aria-describedby="cidadeHelp">
                <option value="">Selecione uma cidade</option>
            </select>
            <small id="cidadeHelp" class="text-muted">Escolha sua cidade</small>
        </div>

        <div class="btn-group mt-4">
            <button type="submit" id="btnContinuar" class="btn btn--lg">
                Continuar
                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
        function obterCidades(idEstado) {
            var $selectCidade = $('#idCidadePaciente');
            $selectCidade.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ObterCidades", "Cidade", new { area = "Admin" })',
                type: 'GET',
                data: { idEstado: idEstado },
                success: function (resposta) {
                    $selectCidade.empty();
                    $selectCidade.append('<option value="">Selecione uma cidade</option>');

                    if (resposta.sucesso) {
                        $.each(resposta.listaCidades, function (index, cidade) {
                            var selected = '@Model.idCidadePaciente' == cidade.idCidade ? ' selected' : '';
                            $selectCidade.append('<option value="' + cidade.idCidade + '"' + selected + '>' + cidade.nome + '</option>');
                        });
                    } else {
                        exibirAlerta(resposta.mensagem);
                    }

                    $selectCidade.prop('disabled', false);
                },
                error: function () {
                    exibirAlerta('Erro ao carregar as cidades.');
                    $selectCidade.prop('disabled', false);
                }
            });
        }

        $(document).ready(function () {
            // Carrega cidades se já tiver estado selecionado
            var estadoInicial = '@Model.idEstadoPaciente';
            if (estadoInicial) {
                $('#idEstadoPaciente').val(estadoInicial);
                obterCidades(estadoInicial);
            }

            // Evento de mudança do estado
            $('#idEstadoPaciente').change(function () {
                var idEstado = $(this).val();

                if (idEstado) {
                    obterCidades(idEstado);
                } else {
                    $('#idCidadePaciente').empty();
                    $('#idCidadePaciente').append('<option value="">Selecione uma cidade</option>');
                }
            });

            // Submissão do formulário
            $('#formEtapa1').submit(function (e) {
                e.preventDefault();

                var formData = $(this).serialize();
                var $btn = $('#btnContinuar');
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("NovoAgendamentoEtapa1", "Agendamento")',
                    type: 'POST',
                    data: formData,
                    success: function (resposta) {
                        if (resposta.sucesso) {
                            window.location.href = '@Url.Action("NovoAgendamentoEtapa2", "Agendamento")';
                        } else {
                            exibirAlerta(resposta.mensagem);
                            $btn.prop('disabled', false);
                        }
                    },
                    error: function (xhr, status, error) {
                        exibirAlerta('Erro ao finalizar etapa. Tente novamente.');
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
