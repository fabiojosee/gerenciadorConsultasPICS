@model List<AgendaPics.Web.Areas.Admin.ViewModels.Pratica.MinhasPraticasViewModel>
@{
    ViewData["Title"] = "Minhas Práticas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="list-container animate-fade-in">
    <h1>Minhas Práticas</h1>
    <p class="text-muted mb-4">Gerencie as práticas vinculadas à sua instituição</p>

    <div class="mt-4">
        @if (Model.Count == 0)
        {
            <!-- Empty State -->
            <div class="empty-state">
                <svg class="empty-state__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                </svg>
                <h2 class="empty-state__title">Nenhuma prática vinculada</h2>
                <p class="empty-state__text">A instituição ainda não possui práticas vinculadas.</p>
                <button type="button" class="btn" id="btnVincularPraticaEmpty">
                    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Vincular Primeira Prática
                </button>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <article class="card" role="article" aria-label="Prática: @item.nome">
                    <div class="card__header">
                        <h3 class="card__title">@item.nome</h3>
                    </div>
                    <div class="card-body">
                        <!-- Periodicidade -->
                        <div class="d-flex align-center gap-2 mb-2">
                            <svg class="icon icon--sm text-primary" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@item.textoPeriodicidade</span>
                        </div>

                        <!-- Quantidade de Sessões -->
                        <div class="d-flex align-center gap-2 mb-2">
                            <svg class="icon icon--sm text-muted" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <line x1="20" y1="8" x2="20" y2="14"></line>
                                <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                            <span>@item.textoQtdSessoes</span>
                        </div>

                        <!-- Dia Permitido -->
                        <div class="d-flex align-center gap-2 mb-3">
                            <svg class="icon icon--sm text-muted" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>@item.textoDiaPermitidoParaAgendamento</span>
                        </div>

                        <!-- Ações -->
                        <div class="card__actions">
                            <button type="button"
                                    class="btn"
                                    onclick="editarPratica(@item.idPratica)"
                                    aria-label="Editar prática @item.nome">
                                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                Editar
                            </button>
                            <button type="button"
                                    class="btn-cancelar"
                                    onclick="desvincularPratica(@item.idPratica, @item.idInstituicao)"
                                    aria-label="Desvincular prática @item.nome">
                                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M18 6L6 18"></path>
                                    <path d="M6 6l12 12"></path>
                                </svg>
                                Desvincular
                            </button>
                        </div>
                    </div>
                </article>
            }
        }
    </div>

    @if (Model.Count > 0)
    {
        <div class="mt-4 text-center">
            <button type="button" class="btn btn--lg" id="btnVincularPratica">
                <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Vincular Nova Prática
            </button>
        </div>
    }
</div>

@section Scripts {
    <script type="text/javascript">
        function editarPratica(idPratica) {
            window.location.href = '/Admin/Pratica/EdicaoVinculoPratica?idPratica=' + idPratica;
        }

        function desvincularPratica(idPratica, idInstituicao) {
            exibirConfirmacao(
                'Desvincular Prática',
                'Tem certeza que deseja desvincular esta prática? Esta ação não pode ser desfeita.',
                function() {
                    $.ajax({
                        url: '@Url.Action("DesvincularPratica", "Pratica")',
                        type: 'DELETE',
                        data: {
                            idPratica: idPratica,
                            idInstituicao: idInstituicao
                        },
                        success: function (resposta) {
                            if (resposta.sucesso) {
                                exibirSucesso('Prática desvinculada com sucesso!');
                                setTimeout(function() {
                                    window.location.reload(true);
                                }, 1500);
                            } else {
                                exibirAlerta(resposta.mensagem);
                            }
                        },
                        error: function (xhr, status, error) {
                            exibirAlerta('Erro ao desvincular prática.');
                        }
                    });
                }
            );
        }

        $(document).ready(function () {
            configurarBotaoVoltar('@Url.Action("AreaAdministrativaInstituicao", "Login")');

            $('#btnVincularPratica, #btnVincularPraticaEmpty').on('click', function () {
                window.location.href = '@Url.Action("VinculoPratica", "Pratica")';
            });
        });
    </script>
}
