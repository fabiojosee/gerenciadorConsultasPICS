@{
    ViewData["Title"] = "Área da Instituição";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-container container-centralizado animate-fade-in">
    <h1>Painel da Instituição</h1>
    <p class="text-muted mb-4">Gerencie seus atendimentos e práticas</p>

    <div class="btn-group">
        <a class="btn btn--lg" href="/Usuario/Atendimento/MeusAtendimentosInstituicao">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Atendimentos
        </a>

        <a class="btn btn--lg" href="/Admin/Pratica/MinhasPraticas">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            Minhas Práticas
        </a>

        <a class="btn btn--outline btn--lg" href="@ViewBag.FormularioNovaPratica" target="_blank" rel="noopener noreferrer">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Solicitar Nova Prática
        </a>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            configurarBotaoVoltar('@Url.Action("Logout", "Login")');
        });
    </script>
}
