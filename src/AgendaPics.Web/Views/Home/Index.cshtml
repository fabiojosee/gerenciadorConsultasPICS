@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container container-centralizado animate-fade-in">
    <!-- Logo -->
    <svg class="icon iconApp" aria-hidden="true" focusable="false">
        <use xlink:href="/images/sprite.svg#app-icon"></use>
    </svg>

    <!-- Título -->
    <h1 class="nomeApp">Agenda PICS</h1>
    <p class="text-muted mb-4">Práticas Integrativas e Complementares em Saúde</p>

    <!-- Botões de Ação -->
    <div class="btn-group">
        <a class="btn btn--lg" href="/Usuario/Agendamento/NovoAgendamentoEtapa1">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="12" y1="14" x2="12" y2="18"></line>
                <line x1="10" y1="16" x2="14" y2="16"></line>
            </svg>
            Novo Agendamento
        </a>

        <button type="button" class="btn btn--outline btn--lg" onclick="exibirModalCpf()">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Meus Atendimentos
        </button>

        <a class="btn btn--secondary btn--lg" href="/Admin/Login/Login">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Área Administrativa
        </a>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        function exibirModalCpf() {
            Swal.fire({
                title: "Informe seu CPF",
                input: "text",
                inputLabel: "Digite seu CPF para consultar seus atendimentos",
                inputPlaceholder: "000.000.000-00",
                inputAttributes: {
                    maxlength: '14',
                    inputmode: 'numeric',
                    autocomplete: 'off'
                },
                inputValidator: (value) => {
                    let cpfLimpo = value.replace(/\D/g, '');
                    if (!validarCPF(cpfLimpo)) {
                        return 'CPF inválido! Verifique os números digitados.';
                    }
                },
                didOpen: () => {
                    const inputElement = Swal.getInput();
                    inputElement.addEventListener('input', (e) => {
                        mascaraCPF(e.target);
                    });
                },
                showCancelButton: true,
                cancelButtonText: 'Cancelar',
                confirmButtonText: 'Consultar',
                confirmButtonColor: '#4CAF50',
                cancelButtonColor: '#6c757d',
                customClass: {
                    popup: 'animate-slide-up'
                }
            }).then((resultado) => {
                if (resultado.isConfirmed) {
                    window.location.href = '/Usuario/Atendimento/MeusAtendimentos?cpf=' + resultado.value.replace(/\D/g, '');
                }
            });
        }
    </script>
}
